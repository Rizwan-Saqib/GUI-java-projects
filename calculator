import javax.swing.*;
import javax.swing.plaf.BorderUIResource;

import java.awt.*;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;


public class Calculator11 {
    static JTextField field = new JTextField();
    static int num1 = 0;
    static int num2 = 0;
    static String operator = "";

    public static void main(String args[]) {

        JFrame frame = new JFrame(" Calculator ");
        frame.setSize(300, 450);
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        field.setPreferredSize(new Dimension(290, 40));
        field.setEditable(false);
        field.setBorder(BorderUIResource.getBlackLineBorderUIResource());
        JPanel panel = new JPanel();
        panel.setLayout(new BorderLayout());
        panel.setLayout(new GridLayout(4, 4, 5, 5)); // numbers ke liye
        String[] nums = {

                "1", "2", "3", "+",
                "4", "5", "6", "-",
                "7", "8", "9", "*",
                "=", "0", "C", "/",
        };
        for (String n : nums) {
            JButton btn = new JButton(n);
            btn.addActionListener(new ActionListener() {
                public void actionPerformed(ActionEvent e) {

                    String clicked = e.getActionCommand();
                    if (clicked.equals("C")) {

                        field.setText("");
                    }else  if (clicked.equals("+") || clicked.equals("-") || clicked.equals("*")
                            || clicked.equals("/")) {
                        operator = clicked;
                        num1 = Integer.parseInt(field.getText());
                        field.setText("");

                    } else if (clicked.equals("=")) {
                       num2 = Integer.parseInt(field.getText());
                        switch (operator) {
                            
                            case "+":
                                
                                field.setText(String.valueOf(num1 + num2));
                                break;
                            case "-":
                                field.setText(String.valueOf(num1 - num2));
                                break;
                            case "*":
                            field.setText(String.valueOf(num1 * num2));
                                break;
                            case "/":
                            field.setText(String.valueOf(num1 / num2));
                                break;

                            default:
                                field.setText("Invlid Input");
                                break;
                        }

                    }else{
                                            field.setText(field.getText() + e.getActionCommand());

                    }

                }
            });
            btn.setFont(new Font("Arial", Font.ROMAN_BASELINE, 22));
            btn.setForeground(Color.BLACK);
            btn.setBackground(Color.WHITE); 
            btn.setFocusPainted(true);
            btn.setCursor(new Cursor(Cursor.HAND_CURSOR));
            panel.add(btn);
        }

        frame.getContentPane().setBackground(Color.black);
        frame.add(panel, BorderLayout.CENTER);
        frame.setVisible(true);
        frame.add(field, BorderLayout.NORTH);
    }
}
